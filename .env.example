# ==============================================================================
# ResolveHelm Configuration Example
# Copy this file to .env and supply actual values. Never commit .env to version control.
# ==============================================================================

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO
DRY_RUN=true
AUTO_SEND_ENABLED=false
POLL_INTERVAL_SECONDS=30
MAX_MESSAGE_ATTEMPTS=3
MAX_EMAIL_BODY_CHARS=10000
MODEL_TIMEOUT_SECONDS=30.0

# Database (Supabase / PostgreSQL)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resolvehelm

# Gmail OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token

# AI Models (Anthropic / Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key
CLASSIFIER_MODEL=claude-3-5-haiku-latest
AGENT_MODEL=claude-3-5-sonnet-latest

# Dashboard Authentication
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me-to-a-secure-password
